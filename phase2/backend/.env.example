# Copy to .env and fill in. NEVER commit the real .env file.

# Reddit (optional — PRAW live mode). Create an app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MyntraDiscoveryEngine/0.1

# YouTube (optional — YouTube Data API v3, free key from console.cloud.google.com)
YOUTUBE_API_KEY=

# App Store (optional — app-store-scraper)
APP_STORE_COUNTRY=in

# LLM provider keys — used in Phase 3 (relevance) and Phase 4 (extraction).
# GROQ (free, fast) and GOOGLE/Gemini (free tier) are preferred; OpenAI/Anthropic paid.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
